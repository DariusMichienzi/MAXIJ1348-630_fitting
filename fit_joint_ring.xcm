# Joint fit of every NuSTAR observation with the ring-corona reflection model.
#
#   Model: constant * tbabs * ( diskbb + cutoffpl + kzring * atable{xillverD-5.fits} )
#
# Each observation gives two data groups (FPMA, FPMB):
#   constant  FPMA fixed at 1, FPMB free; separate for every observation
#   nH        fixed at nH below, the same for all
#   global    spin, inclination, iron abundance and disc density: one value
#             shared by every observation (list in global_params)
#   per obs   everything else (disc, continuum, ring height and radius,
#             ionisation, reflection norm): free for each observation, shared
#             by its FPMA and FPMB
#
# Starting values come from the single-observation fits written by
# fit_all_ring.xcm (Ring/<obsID>_stage2.xcm): every per-observation parameter,
# including the normalisations and FPMB's constant, starts at that
# observation's own best fit, and each global parameter at the median over the
# observations. When every observation has such a file the fit starts straight
# from there with everything free. Otherwise it falls back to the stages:
#
# Stage 1  continuum only (reflection off, 4-8 and 12-40 keV ignored)
# Stage 2  reflection on, full band: ionisation, then geometry and the global
#          parameters; disc density optionally
#
# Writes in datadir/Ring/: joint_stage1.xcm, joint_stage2.xcm, joint.ps,
# joint.log and joint_summary.csv (one row per parameter and observation).
#
# Interactive:  XSPEC12> @fit_joint_ring.xcm
# Batch:        set batch to 1, then  nohup xspec - fit_joint_ring.xcm > fit_joint_ring.out 2>&1 &

# settings

set datadir  "/Users/er19801/data"
set xillver  "/Users/er19801/JuliaXSPEC.jl/xillverD-5.fits"
set fitstat  chi
set nH       0.86
set redshift 0.0
set batch    0
set libdir   "/Users/er19801/JuliaXSPEC.jl/build/kerrz/xspec"
set obsids   {}           ;# leave empty to use every observation in datadir
set fit_dens 0            ;# 1: free the (global) disc density in a last step
set per_obs_errors 0      ;# 1: also compute errors on every per-observation parameter (slow)

# setup

if {$batch} { lmod juliaxspec $libdir }
cd $datadir
file mkdir Ring
query yes
abund wilm
xsect vern
setplot energy
setplot add
setplot rebin 20 40
energies 0.05 1000 5000 log
file delete -force Ring/joint.log
log Ring/joint.log

# Parameter numbers within one data group
#    1 factor | 2 nH | 3 Tin, 4 norm | 5 PhoIndex, 6 HighECut, 7 norm
#    8 a, 9 inc, 10 h, 11 x | 12 Gamma, 13 A_Fe, 14 logXi, 15 Dens, 16 Incl
#    [17 z] | last: xillver norm
set global_params {8 9 13 15}
set names [dict create 3 Tin 4 disc_norm 5 PhoIndex 6 HighECut 7 cont_norm \
                       8 a 9 inc 10 h 11 x 13 A_Fe 14 logXi 15 Dens]

# observations

if {[llength $obsids] == 0} {
    foreach f [lsort [glob -nocomplain nu*A01_sr_1000.pha]] {
        if {[regexp {^nu(.+)A01_sr_1000\.pha$} $f -> id] && [file exists nu${id}B01_sr_1000.pha]} {
            lappend obsids $id
        }
    }
}
set nobs [llength $obsids]
set ng [expr {2 * $nobs}]
puts "Joint fit of $nobs observations ($ng data groups): $obsids"

set spec {}
set g 0
foreach id $obsids {
    lappend spec [incr g]:$g nu${id}A01_sr_1000.pha
    lappend spec [incr g]:$g nu${id}B01_sr_1000.pha
}
data none
model clear
eval [concat data $spec]
ignore bad
ignore 1-$ng:**-3.0 80.0-**
statistic $fitstat

# starting values from the single-observation fits

# The parameter values in an XSPEC save file: the lines after its "model"
# line, one per parameter, either numbers ("value delta min bot top max") or
# a link ("= p5"). Returns the values in order, "" for linked parameters.
proc read_saved_params {path} {
    set ch [open $path r]
    set lines [split [read $ch] "\n"]
    close $ch
    set values {}
    set in_params 0
    foreach line $lines {
        set line [string trim $line]
        if {!$in_params} {
            if {[string match "model *" $line]} { set in_params 1 }
            continue
        }
        if {[string match "=*" $line]} {
            lappend values ""
        } elseif {[llength $line] >= 6 && [string is double -strict [lindex $line 0]]} {
            lappend values [lindex $line 0]
        } else {
            break
        }
    }
    return $values
}

set starts [dict create]
set have_all 1
foreach id $obsids {
    set path Ring/${id}_stage2.xcm
    if {[file exists $path] && ![catch {read_saved_params $path} vals]} {
        dict set starts $id $vals
    } else {
        puts "No individual fit for $id ($path): default starting values"
        set have_all 0
    }
}

# Observation obsid's best-fit value of parameter j (FPMA group numbering;
# per + 1 is FPMB's constant), or the default if there is none. The value is
# kept inside parameter j's hard limits (for xillver's parameters, the table's
# range), so a misread or out-of-range value can never reach the table.
proc start {obsid j default} {
    global starts xspec_tclout
    if {![dict exists $starts $obsid]} { return $default }
    set v [lindex [dict get $starts $obsid] [expr {$j - 1}]]
    if {![string is double -strict $v]} { return $default }
    tclout param $j
    if {[llength $xspec_tclout] >= 6} {
        set lo [lindex $xspec_tclout 2]
        set hi [lindex $xspec_tclout 5]
        if {$v < $lo || $v > $hi} {
            puts "Start value $v for parameter $j of $obsid is outside $lo - $hi: clamped"
            set v [expr {min(max($v, $lo), $hi)}]
        }
    }
    return $v
}

# Median of parameter j over the individual fits, or the default
proc start_median {j default} {
    global obsids
    set values {}
    foreach id $obsids {
        set v [start $id $j ""]
        if {$v ne ""} { lappend values $v }
    }
    if {[llength $values] == 0} { return $default }
    set values [lsort -real $values]
    set n [llength $values]
    if {$n % 2} { return [lindex $values [expr {$n / 2}]] }
    return [expr {([lindex $values [expr {$n / 2 - 1}]] + [lindex $values [expr {$n / 2}]]) / 2.0}]
}

# model

model constant*tbabs*(diskbb + cutoffpl + kzring*atable{$xillver}) & /*

tclout modpar
set npar $xspec_tclout
if {$npar == 17 || $npar == 18} { set per $npar } else { set per [expr {$npar / $ng}] }
set p_xnorm $per
if {$per == 18} { newpar 17 $redshift -1 }
lappend names $p_xnorm refl_norm

# An individual fit is only usable if it has the same model (two data groups)
foreach id [dict keys $starts] {
    if {[llength [dict get $starts $id]] != 2 * $per} {
        puts "Fit file for $id does not match this model: default starting values"
        dict unset starts $id
        set have_all 0
    }
}
if {$have_all} {
    puts "Starting from the individual fits of all $nobs observations"
} else {
    puts "Not every observation has a usable individual fit: fitting in stages"
}

# Parameter number of parameter j in data group g
proc pidx {g j} {
    global per
    return [expr {($g - 1) * $per + $j}]
}

# Table limits for xillver's Gamma and Incl, which follow PhoIndex and inc
tclout param 12
set gmin [lindex $xspec_tclout 2]
set gmax [lindex $xspec_tclout 5]
tclout param 16
set imin [expr {max(5.0, [lindex $xspec_tclout 2])}]
set imax [expr {min(85.0, [lindex $xspec_tclout 5])}]

# Shared by everything (set once, in data group 1; other groups follow it)
newpar 1 1.0 -1
newpar 2 $nH -1
newpar 8 [start_median 8 0.9] 0.01
newpar 9 [start_median 9 30] 1 $imin $imin $imax $imax
newpar 13 [start_median 13 1.0] 0.1
tclout param 15
set dens_min [lindex $xspec_tclout 2]
newpar 15 [start_median 15 $dens_min] -1   ;# frozen unless fit_dens is 1

# Set observation k's own parameters on its FPMA group, link its FPMB group
# to them, and give FPMB its own free constant.
proc setup_obs {k} {
    global obsids p_xnorm gmin gmax per have_all
    set id [lindex $obsids [expr {$k - 1}]]
    set gA [expr {2 * $k - 1}]
    set gB [expr {2 * $k}]
    set own [list 3 4 5 6 7 10 11 14 $p_xnorm]

    if {$k > 1} {
        foreach j $own { untie [pidx $gA $j] }
    }
    newpar [pidx $gA 3] [start $id 3 1.0] 0.01 0.1 0.1 3.0 3.0
    newpar [pidx $gA 4] [start $id 4 1000] 1
    newpar [pidx $gA 5] [start $id 5 2.0] 0.01 $gmin $gmin $gmax $gmax
    newpar [pidx $gA 6] [start $id 6 100] 1 10 10 500 500
    newpar [pidx $gA 7] [start $id 7 1.0] 0.01
    newpar [pidx $gA 10] [start $id 10 5] 0.1
    newpar [pidx $gA 11] [start $id 11 4] 0.1
    newpar [pidx $gA 14] [start $id 14 3.0] 0.1
    if {$have_all} {
        newpar [pidx $gA $p_xnorm] [start $id $p_xnorm 1e-3] 0.01
    } else {
        newpar [pidx $gA $p_xnorm] 0 -1
    }

    # xillver's Gamma follows this observation's photon index; Incl follows inc
    newpar [pidx $gA 12] = p[pidx $gA 5]
    newpar [pidx $gA 16] = p9

    puts [format "Start %s: Tin %s  PhoIndex %s  HighECut %s  h %s  x %s  logXi %s  refl_norm %s  const_B %s" \
        $id [start $id 3 -] [start $id 5 -] [start $id 6 -] [start $id 10 -] [start $id 11 -] \
        [start $id 14 -] [start $id $p_xnorm -] [start $id [expr {$per + 1}] -]]

    if {$k > 1} {
        foreach j $own { newpar [pidx $gB $j] = p[pidx $gA $j] }
        newpar [pidx $gB 12] = p[pidx $gA 5]
    }

    untie [pidx $gB 1]
    newpar [pidx $gB 1] [start $id [expr {$per + 1}] 1.0] 0.01 0.5 0.8 1.2 1.5
}

for {set k 1} {$k <= $nobs} {incr k} { setup_obs $k }

# Parameter numbers of one of each observation's own parameters
proc own_params {j} {
    global nobs
    set out {}
    for {set k 1} {$k <= $nobs} {incr k} { lappend out [pidx [expr {2 * $k - 1}] $j] }
    return $out
}

show param

if {$have_all} {

    # Every observation starts at its own best fit: free everything at once
    eval thaw [own_params 10] [own_params 11] [own_params 14]
    thaw 8 9 13
    fit 2000

} else {

    # stage 1: continuum only
    freeze 8 9 13 15
    eval freeze [own_params 10] [own_params 11] [own_params 14]
    ignore 1-$ng:4.0-8.0 12.0-40.0
    fit 1000
    show fit
    file delete -force Ring/joint_stage1.xcm
    save all Ring/joint_stage1.xcm

    # stage 2: reflection on, full band
    notice 1-$ng:4.0-8.0 12.0-40.0
    ignore bad
    for {set k 1} {$k <= $nobs} {incr k} {
        set gA [expr {2 * $k - 1}]
        tclout param [pidx $gA 7]
        newpar [pidx $gA $p_xnorm] [expr {0.01 * [lindex $xspec_tclout 0]}] 0.01
    }

    # 2a. ionisation, geometry still at its starting values
    eval thaw [own_params 14]
    fit 1000

    # 2b. ring height and radius for each observation, spin, inclination, iron abundance
    eval thaw [own_params 10] [own_params 11]
    thaw 8 9 13
    fit 2000
}

# 2c. disc density (one value for all observations)
if {$fit_dens} {
    thaw 15
    fit 2000
}

show fit
file delete -force Ring/joint_stage2.xcm
save all Ring/joint_stage2.xcm

# errors (90 %): the shared parameters, then optionally every observation's own

set error_params {8 9 13}
if {$fit_dens} { lappend error_params 15 }
eval error 2.706 $error_params
if {$per_obs_errors} {
    foreach j {3 6 10 11 14} { eval error 2.706 [own_params $j] }
}

file delete -force Ring/joint_stage2.xcm
save all Ring/joint_stage2.xcm

cpd Ring/joint.ps/cps
plot eeufspec delchi
cpd none

# summary: one row per parameter and observation ("all" for shared ones)

proc append_line {path text} {
    set ch [open $path a]
    puts $ch $text
    close $ch
}

proc param_row {label name p} {
    global xspec_tclout
    tclout param $p
    set value [lindex $xspec_tclout 0]
    set delta [lindex $xspec_tclout 1]
    tclout error $p
    set lo [lindex $xspec_tclout 0]
    set hi [lindex $xspec_tclout 1]
    if {$delta < 0 || ($lo == 0 && $hi == 0)} { set lo ""; set hi "" }
    return [join [list $label $name $value $lo $hi] ","]
}

set out Ring/joint_summary.csv
file delete -force $out
append_line $out "obsid,param,value,lo,hi"
tclout stat
set stat $xspec_tclout
tclout dof
append_line $out "all,stat,$stat,,"
append_line $out "all,dof,[lindex $xspec_tclout 0],,"
foreach j $global_params {
    append_line $out [param_row all [dict get $names $j] $j]
}
for {set k 1} {$k <= $nobs} {incr k} {
    set id [lindex $obsids [expr {$k - 1}]]
    set gA [expr {2 * $k - 1}]
    foreach j [list 3 4 5 6 7 10 11 14 $p_xnorm] {
        append_line $out [param_row $id [dict get $names $j] [pidx $gA $j]]
    }
    append_line $out [param_row $id const_B [pidx [expr {2 * $k}] 1]]
}

log none
puts "\nDone: joint fit results in $datadir/Ring/"
if {$batch} { exit }
