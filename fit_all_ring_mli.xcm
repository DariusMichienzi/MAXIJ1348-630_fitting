# Refit every observation (optimally binned spectra) with the NuSTAR MLI
# correction, following the SOC procedure for each:
#   1. FPMA ignored between 3 and 7 keV; fit; freeze the FPMA/FPMB constant
#   2. FPMA 3-7 keV noticed; FPMA's MLI fraction free, FPMB's fixed at 1; refit
#
#   Model: constant * mtable{nuMLIv1.mod} * tbabs * ( diskbb + cutoffpl + kzring * atable{xillverD-5.fits} )
#
# Starts each observation from its Ring/<obsID>_opt.xcm (with or without the
# mtable). Overwrites, in datadir:
#   Ring/<obsID>_opt.xcm, Ring/<obsID>_opt.ps, Ring/<obsID>_opt.log, Images/<obsID>.gif
#   Ring/summary.csv  rewritten with an extra MLI_A column (the previous one is
#                     first copied once to Ring/summary_nomli.csv)
#
# Needs nuMLIv1.mod in datadir:
#   curl -O https://nustarsoc.caltech.edu/NuSTAR_Public/NuSTAROperationSite/MLI/nuMLIv1.mod
#
# Interactive:  XSPEC12> @fit_all_ring_mli.xcm
# Batch:        set batch to 1, then  nohup xspec - fit_all_ring_mli.xcm > fit_mli.out 2>&1 &

# settings

set datadir  "/Users/er19801/nustar-data"
set xillver  "/Users/er19801/JuliaXSPEC.jl/xillverD-5.fits"
set mlifile  "nuMLIv1.mod"
set suffix   "_sr_opt.pha"
set nH       0.86
set redshift 0.0
set batch    0
set libdir   "/Users/er19801/JuliaXSPEC.jl/build/kerrz/xspec"
set obsids   {}           ;# leave empty to fit every observation in datadir

# setup

if {$batch} { lmod juliaxspec $libdir }
cd $datadir
file mkdir Ring
file mkdir Images
if {![file exists $mlifile]} {
    puts "$mlifile not found in $datadir: download it first (see the top of this script)"
    return
}
query yes
abund wilm
xsect vern
setplot energy
setplot add
setplot rebin 20 40
energies 0.05 1000 5000 log
set env(PGPLOT_BACKGROUND) white
set env(PGPLOT_FOREGROUND) black

# Parameters in the summary, in the usual numbering (without the mtable)
set summary_params {3 Tin 5 PhoIndex 6 HighECut 8 a 9 inc 10 h 11 x 13 A_Fe 14 logXi 15 Dens}

# helpers

proc append_line {path text} {
    set ch [open $path a]
    puts $ch $text
    close $ch
}

# Parameter lines of an XSPEC save file, and whether its model has the mtable.
# Returns {has_mtable entries}; each entry "value delta min bot top max" as a
# list, or "" for a linked parameter.
proc read_saved_params {path} {
    set ch [open $path r]
    set lines [split [read $ch] "\n"]
    close $ch
    set values {}
    set in_params 0
    set has_mtable 0
    foreach line $lines {
        set line [string trim $line]
        if {!$in_params} {
            if {[string match "model *" $line]} {
                set in_params 1
                set has_mtable [string match -nocase "*mtable*" $line]
            }
            continue
        }
        if {[string match "=*" $line]} {
            lappend values ""
        } elseif {[llength $line] >= 6 && [string is double -strict [lindex $line 0]]} {
            lappend values [lrange $line 0 5]
        } else {
            break
        }
    }
    return [list $has_mtable $values]
}

# Usual parameter j -> number in this model (constant 1, mtable 2, rest +1)
proc m {j} {
    if {$j == 1} { return 1 }
    return [expr {$j + 1}]
}

# The model with its links and limits. Sets globals per, p_xnorm, c2, mliA, mliB.
proc build_model {} {
    global xspec_tclout xillver mlifile nH redshift per p_xnorm c2 mliA mliB
    model constant*mtable{$mlifile}*tbabs*(diskbb + cutoffpl + kzring*atable{$xillver}) & /*
    tclout modpar
    set npar $xspec_tclout
    if {$npar == 18 || $npar == 19} { set per $npar } else { set per [expr {$npar / 2}] }
    if {$per != 18 && $per != 19} {
        error "unexpected number of parameters ($per per data group)"
    }
    set p_xnorm $per
    set c2   [expr {$per + 1}]
    set mliA 2
    set mliB [expr {$per + 2}]
    if {$per == 19} { newpar [m 17] $redshift -1 }

    newpar 1 1.0 -1
    untie $c2
    newpar $c2 1.0 0.01 0.5 0.8 1.2 1.5
    newpar [m 2] $nH -1
    newpar [m 3] 1.0 0.01 0.1 0.1 3.0 3.0
    newpar [m 4] 1000 1
    tclout param [m 12]
    set gmin [lindex $xspec_tclout 2]
    set gmax [lindex $xspec_tclout 5]
    tclout param [m 16]
    set imin [expr {max(5.0, [lindex $xspec_tclout 2])}]
    set imax [expr {min(85.0, [lindex $xspec_tclout 5])}]
    newpar [m 5] 2.0 0.01 $gmin $gmin $gmax $gmax
    newpar [m 6] 100 1 10 10 500 500
    newpar [m 7] 1.0 0.01
    newpar [m 8] 0.9 0.01
    newpar [m 9] 30 1 $imin $imin $imax $imax
    newpar [m 10] 5 0.1
    newpar [m 11] 4 0.1
    newpar [m 12] = p[m 5]
    newpar [m 13] 1.0 -1
    newpar [m 14] 3.0 0.1
    newpar [m 15] 15 -1
    newpar [m 16] = p[m 9]
}

# Set parameters from a saved fit (with or without the mtable); links kept
proc apply_saved {has_mtable entries} {
    global c2
    set old_per [expr {[llength $entries] / 2}]
    for {set j 1} {$j <= $old_per} {incr j} {
        set e [lindex $entries [expr {$j - 1}]]
        if {[llength $e] != 6} { continue }
        if {$has_mtable} {
            if {$j == 2 || $j == 13 || $j == 17} { continue }   ;# MLI, Gamma, Incl
            eval newpar $j $e
        } else {
            if {$j == 12 || $j == 16} { continue }              ;# Gamma, Incl
            eval newpar [m $j] $e
        }
    }
    set e [lindex $entries $old_per]
    if {[llength $e] == 6} { eval newpar $c2 $e }
}

# Is a saved fit usable here?
proc saved_ok {has_mtable entries} {
    set n [llength $entries]
    if {$has_mtable} { return [expr {$n == 36 || $n == 38}] }
    return [expr {$n == 34 || $n == 36}]
}

# The staged procedure, for observations without a usable saved fit
proc staged_fit {} {
    global xspec_tclout p_xnorm
    newpar $p_xnorm 0 -1
    freeze [m 8] [m 9] [m 10] [m 11] [m 14]
    ignore 1-2:4.0-8.0 12.0-40.0
    fit 500
    notice 1-2:4.0-8.0 12.0-40.0
    ignore bad
    tclout param [m 7]
    newpar $p_xnorm [expr {0.01 * [lindex $xspec_tclout 0]}] 0.01
    thaw [m 14]
    fit 500
    thaw [m 8] [m 9] [m 10] [m 11]
    fit 1000
}

# one observation

proc fit_obs {obsid} {
    global xspec_tclout suffix summary_params c2 mliA mliB

    data none
    model clear
    data 1:1 nu${obsid}A01${suffix} 2:2 nu${obsid}B01${suffix}
    ignore bad
    ignore 1-2:**-3.0 80.0-**
    statistic cstat

    build_model

    set saved Ring/${obsid}_opt.xcm
    set parsed {}
    if {[file exists $saved] && ![catch {read_saved_params $saved} parsed] \
            && [saved_ok [lindex $parsed 0] [lindex $parsed 1]]} {
        puts "Starting from $saved"
        apply_saved [lindex $parsed 0] [lindex $parsed 1]
        set from_saved 1
    } else {
        puts "No usable saved fit for $obsid: fitting in stages from the defaults"
        set from_saved 0
    }

    # MLI fractions start at 1 and fixed; FPMB's stays so throughout
    newpar $mliA 1.0 -1
    untie $mliB
    newpar $mliB 1.0 -1
    if {!$from_saved} { staged_fit }

    # Step 1: FPMA 3-7 keV ignored, constant found and frozen
    thaw $c2
    ignore 1:3.0-7.0
    fit 1000
    tclout param $c2
    puts "Step 1: FPMB constant = [lindex $xspec_tclout 0] (now frozen)"
    freeze $c2

    # Step 2: FPMA 3-7 keV back, FPMA's MLI fraction free
    notice 1:3.0-7.0
    ignore bad
    newpar $mliA 0.95 0.01
    fit 1000
    tclout param $mliA
    puts "Step 2: FPMA MLI fraction = [lindex $xspec_tclout 0]"

    # A_Fe and Dens: kept as they were if free, retested if frozen
    tclout param [m 13]
    if {[lindex $xspec_tclout 1] > 0} {
        set fe_dens_free 1
    } else {
        tclout stat
        set stat_fixed $xspec_tclout
        thaw [m 13] [m 15]
        fit 1000
        tclout stat
        set improvement [expr {$stat_fixed - $xspec_tclout}]
        puts "Improvement from freeing A_Fe and Dens: $improvement"
        if {$improvement >= 5.99} {
            set fe_dens_free 1
        } else {
            tclout param [m 15]
            set dens_min [lindex $xspec_tclout 2]
            newpar [m 13] 1.0 -1
            newpar [m 15] $dens_min -1
            fit 1000
            set fe_dens_free 0
        }
    }
    show fit

    file delete -force Ring/${obsid}_opt.xcm
    save all Ring/${obsid}_opt.xcm

    eval error 2.706 [m 3] [m 6] [m 8] [m 9] [m 10] [m 11] [m 14] $mliA
    if {$fe_dens_free} { error 2.706 [m 13] [m 15] }

    file delete -force Ring/${obsid}_opt.xcm
    save all Ring/${obsid}_opt.xcm

    cpd Ring/${obsid}_opt.ps/cps
    plot eeufspec delchi
    if {[catch {cpd Images/${obsid}.gif/gif; plot eeufspec delchi} err]} {
        puts "Could not write Images/${obsid}.gif: $err"
    }
    cpd none

    tclout stat
    set row [list $obsid $xspec_tclout]
    tclout dof
    lappend row [lindex $xspec_tclout 0] $fe_dens_free
    foreach {p name} $summary_params {
        tclout param [m $p]
        set value [lindex $xspec_tclout 0]
        set delta [lindex $xspec_tclout 1]
        tclout error [m $p]
        set lo [lindex $xspec_tclout 0]
        set hi [lindex $xspec_tclout 1]
        if {$delta < 0} { set lo ""; set hi "" }
        lappend row $value $lo $hi
    }
    tclout param $c2
    lappend row [lindex $xspec_tclout 0] "" ""
    tclout param $mliA
    set value [lindex $xspec_tclout 0]
    tclout error $mliA
    lappend row $value [lindex $xspec_tclout 0] [lindex $xspec_tclout 1]
    return [join $row ","]
}

# all observations

if {[llength $obsids] == 0} {
    foreach f [lsort [glob -nocomplain nu*A01${suffix}]] {
        set id [string range $f 2 end-[string length "A01${suffix}"]]
        if {[file exists nu${id}B01${suffix}]} {
            lappend obsids $id
        } else {
            puts "Skipping $f: no matching FPMB spectrum"
        }
    }
}
puts "Observations to fit: $obsids"

if {[file exists Ring/summary.csv] && ![file exists Ring/summary_nomli.csv]} {
    file copy Ring/summary.csv Ring/summary_nomli.csv
}
set header [list obsid stat dof fe_dens_free]
foreach {p name} [concat $summary_params [list c2 const_B 2 MLI_A]] {
    lappend header $name ${name}_lo ${name}_hi
}
file delete -force Ring/summary.csv
append_line Ring/summary.csv [join $header ","]

foreach id $obsids {
    puts "\n================ $id ================"
    file delete -force Ring/${id}_opt.log
    log Ring/${id}_opt.log
    if {[catch {fit_obs $id} result]} {
        puts "FAILED: $id: $result"
        append_line Ring/summary.csv "$id,failed"
    } else {
        append_line Ring/summary.csv $result
    }
    log none
}
puts "\nDone: fits in $datadir/Ring/, images in $datadir/Images/"

if {$batch} { exit }
