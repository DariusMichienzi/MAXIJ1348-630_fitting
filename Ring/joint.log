!XSPEC12>proc read_saved_params {path} {;    set ch [open $path r];    set lines [split [read $ch] "\n"];    close $ch;    set values {};    set in_params 0;    foreach line $lines {;        set line [string trim $line];        if {!$in_params} {;            if {[string match "model *" $line]} { set in_params 1 };            continue;        };        if {[string match "=*" $line]} {;            lappend values "";        } elseif {[llength $line] >= 6 ;; [string is double -strict [lindex $line 0]]} {;            lappend values [lindex $line 0];        } else {;            break;        };    };    return $values;}
