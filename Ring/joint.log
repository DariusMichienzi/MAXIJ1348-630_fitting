#
!XSPEC12>proc start {obsid j default} {;    global starts xspec_tclout;    if {![dict exists $starts $obsid]} { return $default };    set v [lindex [dict get $starts $obsid] [expr {$j - 1}]];    if {![string is double -strict $v]} { return $default };    tclout param $j;    if {[llength $xspec_tclout] >= 6} {;        set lo [lindex $xspec_tclout 2];        set hi [lindex $xspec_tclout 5];        if {$v < $lo || $v > $hi} {;            puts "Start value $v for parameter $j of $obsid is outside $lo - $hi: clamped";            set v [expr {min(max($v, $lo), $hi)}];        };    };    return $v;}
#
!XSPEC12>proc start_median {j default} {;    global obsids;    set values {};    foreach id $obsids {;        set v [start $id $j ""];        if {$v ne ""} { lappend values $v };    };    if {[llength $values] == 0} { return $default };    set values [lsort -real $values];    set n [llength $values];    if {$n % 2} { return [lindex $values [expr {$n / 2}]] };    return [expr {([lindex $values [expr {$n / 2 - 1}]] + [lindex $values [expr {$n / 2}]]) / 2.0}];}
