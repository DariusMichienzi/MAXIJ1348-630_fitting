!XSPEC12>proc setup_obs {k} {;    global obsids p_xnorm gmin gmax per have_all;    set id [lindex $obsids [expr {$k - 1}]];    set gA [expr {2 * $k - 1}];    set gB [expr {2 * $k}];    set own [list 3 4 5 6 7 10 11 14 $p_xnorm];    if {$k > 1} {;        foreach j $own { untie [pidx $gA $j] };    };    newpar [pidx $gA 3] [start $id 3 1.0] 0.01 0.1 0.1 3.0 3.0;    newpar [pidx $gA 4] [start $id 4 1000] 1;    newpar [pidx $gA 5] [start $id 5 2.0] 0.01 $gmin $gmin $gmax $gmax;    newpar [pidx $gA 6] [start $id 6 100] 1 10 10 500 500;    newpar [pidx $gA 7] [start $id 7 1.0] 0.01;    newpar [pidx $gA 10] [start $id 10 5] 0.1;    newpar [pidx $gA 11] [start $id 11 4] 0.1;    newpar [pidx $gA 14] [start $id 14 3.0] 0.1;    if {$have_all} {;        newpar [pidx $gA $p_xnorm] [start $id $p_xnorm 1e-3] 0.01;    } else {;        newpar [pidx $gA $p_xnorm] 0 -1;    };    newpar [pidx $gA 12] = p[pidx $gA 5];    newpar [pidx $gA 16] = p9;    puts [format "Start %s: Tin %s  PhoIndex %s  HighECut %s  h %s  x %s  logXi %s  refl_norm %s  const_B %s" \;        $id [start $id 3 -] [start $id 5 -] [start $id 6 -] [start $id 10 -] [start $id 11 -] \;        [start $id 14 -] [start $id $p_xnorm -] [start $id [expr {$per + 1}] -]];    if {$k > 1} {;        foreach j $own { newpar [pidx $gB $j] = p[pidx $gA $j] };        newpar [pidx $gB 12] = p[pidx $gA 5];    };    untie [pidx $gB 1];    newpar [pidx $gB 1] [start $id [expr {$per + 1}] 1.0] 0.01 0.5 0.8 1.2 1.5;}
#
!XSPEC12>for {set k 1} {$k <= $nobs} {incr k} { setup_obs $k }
