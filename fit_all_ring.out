!XSPEC12>proc fit_obs {obsid} {;    global xspec_tclout xillver fitstat nH redshift summary_params;    data none;    model clear;    data 1:1 nu${obsid}A01_sr_1000.pha 2:2 nu${obsid}B01_sr_1000.pha;    ignore bad;    ignore 1-2:**-3.0 80.0-**;    statistic $fitstat;    model constant*tbabs*(diskbb + cutoffpl + kzring*atable{$xillver}) ; /*;    tclout modpar;    set npar $xspec_tclout;    if {$npar == 17 || $npar == 34} {;        set per 17;    } else {;        set per 18;        newpar 17 $redshift -1;    };    set p_xnorm $per;    set c2 [expr {$per + 1}];    newpar 1 1.0 -1;    untie $c2;    newpar $c2 1.0 0.01 0.5 0.8 1.2 1.5;    newpar 2 $nH -1;    newpar 3 1.0 0.01 0.1 0.1 3.0 3.0;    newpar 4 1000 1;    tclout param 12;    set gmin [lindex $xspec_tclout 2];    set gmax [lindex $xspec_tclout 5];    tclout param 16;    set imin [expr {max(5.0, [lindex $xspec_tclout 2])}];    set imax [expr {min(85.0, [lindex $xspec_tclout 5])}];    newpar 5 2.0 0.01 $gmin $gmin $gmax $gmax;    newpar 6 100 1 10 10 500 500;    newpar 7 1.0 0.01;    newpar 8 0.9 0.01;    newpar 9 30 1 $imin $imin $imax $imax;    newpar 10 5 0.1;    newpar 11 4 0.1;    newpar 12 = p5;    newpar 13 1.0 -1;    newpar 14 3.0 0.1;    newpar 15 15 -1;    newpar 16 = p9;    newpar $p_xnorm 0 -1;    freeze 8 9 10 11 14;    ignore 1-2:4.0-8.0 12.0-40.0;    fit 500;    show fit;    file delete -force Ring/${obsid}_stage1.xcm;    save all Ring/${obsid}_stage1.xcm;    notice 1-2:4.0-8.0 12.0-40.0;    ignore bad;    tclout param 7;    set xnorm_start [expr {0.01 * [lindex $xspec_tclout 0]}];    newpar $p_xnorm $xnorm_start 0.01;    thaw 14;    fit 500;    thaw 8 9 10 11;    fit 1000;    tclout stat;    set stat_fixed $xspec_tclout;    thaw 13 15;    fit 1000;    tclout stat;    set improvement [expr {$stat_fixed - $xspec_tclout}];    puts "Improvement from freeing A_Fe and Dens: $improvement";    if {$improvement >= 5.99} {;        set fe_dens_free 1;    } else {;        puts "A_Fe and Dens not required: frozen at A_Fe = 1 and the lowest table density";        tclout param 15;        set dens_min [lindex $xspec_tclout 2];        newpar 13 1.0 -1;        newpar 15 $dens_min -1;        fit 1000;        set fe_dens_free 0;    };    show fit;    file delete -force Ring/${obsid}_stage2.xcm;    save all Ring/${obsid}_stage2.xcm;    error 2.706 3 6 8 9 10 11 14 $c2;    if {$fe_dens_free} {;        error 2.706 13 15;    };    file delete -force Ring/${obsid}_stage2.xcm;    save all Ring/${obsid}_stage2.xcm;    cpd Ring/${obsid}.ps/cps;    plot eeufspec delchi;    cpd none;    tclout stat;    set row [list $obsid $xspec_tclout];    tclout dof;    lappend row [lindex $xspec_tclout 0] $fe_dens_free;    foreach {p name} [concat $summary_params [list $c2 const_B]] {;        tclout param $p;        set value [lindex $xspec_tclout 0];        set delta [lindex $xspec_tclout 1];        tclout error $p;        set lo [lindex $xspec_tclout 0];        set hi [lindex $xspec_tclout 1];        if {$delta < 0} { set lo ""; set hi "" }   ;# frozen: no error range;        lappend row $value $lo $hi;    };    return [join $row ","];}

