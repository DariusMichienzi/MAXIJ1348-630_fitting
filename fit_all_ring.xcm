# Run the staged NuSTAR ring-corona fit on every observation in a directory.
#
# Finds every nu<obsID>A01_sr_1000.pha with a matching B01 spectrum in
# datadir, fits each pair with the procedure from fit_nustar_kzring.xcm, and
# writes, in datadir/Ring/:
#   <obsID>_stage1.xcm   continuum-only fit
#   <obsID>_stage2.xcm   full fit (saved before the error runs, then again after)
#   <obsID>.ps           final unfolded spectrum and residuals
#   <obsID>.log          everything XSPEC printed for that observation
#   summary.csv          one line per observation: fit statistic and parameters
#
# Interactive (xspec.rc loads the kerrz library):
#     XSPEC12> @fit_all_ring.xcm
# Batch, e.g. left running with nohup (set batch to 1 first):
#     nohup xspec - fit_all_ring.xcm > fit_all_ring.out 2>&1 &

# settings

set datadir  "/Users/er19801/data"
set xillver  "/Users/er19801/JuliaXSPEC.jl/xillverD-5.fits"
set fitstat  chi          ;# chi for grouped spectra, cstat for ungrouped
set nH       0.86         ;# Galactic column, 1e22 cm^-2
set redshift 0.0
set batch    0            ;# 1 when run with "xspec - fit_all_ring.xcm": loads the library and exits at the end
set libdir   "/Users/er19801/JuliaXSPEC.jl/build/kerrz/xspec"

# setup

if {$batch} { lmod juliaxspec $libdir }
cd $datadir
file mkdir Ring
query yes
abund wilm
xsect vern
setplot energy
setplot add
setplot rebin 20 40
energies 0.05 1000 5000 log

# Parameters in summary.csv (numbers in data group 1; c2 is FPMB's constant)
set summary_params {3 Tin 5 PhoIndex 6 HighECut 8 a 9 inc 10 h 11 x 13 A_Fe 14 logXi 15 Dens}

# one observation

proc fit_obs {obsid} {
    global xspec_tclout xillver fitstat nH redshift summary_params

    data none
    model clear
    data 1:1 nu${obsid}A01_sr_1000.pha 2:2 nu${obsid}B01_sr_1000.pha
    ignore bad
    ignore 1-2:**-3.0 80.0-**
    statistic $fitstat

    # model

    model constant*tbabs*(diskbb + cutoffpl + kzring*atable{$xillver}) & /*

    tclout modpar
    set npar $xspec_tclout
    if {$npar == 17 || $npar == 34} {
        set per 17
    } else {
        set per 18
        newpar 17 $redshift -1
    }
    set p_xnorm $per
    set c2 [expr {$per + 1}]

    # Cross-calibration constant: FPMA fixed at 1, FPMB free
    newpar 1 1.0 -1
    untie $c2
    newpar $c2 1.0 0.01 0.5 0.8 1.2 1.5

    # Absorption
    newpar 2 $nH -1

    # Disc blackbody: Tin free within 0.1-3 keV
    newpar 3 1.0 0.01 0.1 0.1 3.0 3.0
    newpar 4 1000 1

    tclout param 12
    set gmin [lindex $xspec_tclout 2]
    set gmax [lindex $xspec_tclout 5]
    tclout param 16
    set imin [expr {max(5.0, [lindex $xspec_tclout 2])}]
    set imax [expr {min(85.0, [lindex $xspec_tclout 5])}]

    # Coronal continuum
    newpar 5 2.0 0.01 $gmin $gmin $gmax $gmax
    newpar 6 100 1 10 10 500 500
    newpar 7 1.0 0.01

    # Ring corona
    newpar 8 0.9 0.01
    newpar 9 30 1 $imin $imin $imax $imax
    newpar 10 5 0.1
    newpar 11 4 0.1

    # Reflection
    newpar 12 = p5
    newpar 13 1.0 -1
    newpar 14 3.0 0.1
    newpar 15 15 -1
    newpar 16 = p9

    # stage 1: continuum only, reflection off, line and hump ignored

    newpar $p_xnorm 0 -1
    freeze 8 9 10 11 14
    ignore 1-2:4.0-8.0 12.0-40.0
    fit 500
    show fit
    file delete -force Ring/${obsid}_stage1.xcm
    save all Ring/${obsid}_stage1.xcm

    # stage 2: reflection on, full band, everything refitted

    notice 1-2:4.0-8.0 12.0-40.0
    ignore bad

    tclout param 7
    set xnorm_start [expr {0.01 * [lindex $xspec_tclout 0]}]
    newpar $p_xnorm $xnorm_start 0.01

    thaw 14
    fit 500

    thaw 8 9 10 11
    fit 1000

    # A_Fe and Dens: kept free only if they improve the fit by at least 5.99
    tclout stat
    set stat_fixed $xspec_tclout
    thaw 13 15
    fit 1000
    tclout stat
    set improvement [expr {$stat_fixed - $xspec_tclout}]
    puts "Improvement from freeing A_Fe and Dens: $improvement"
    if {$improvement >= 5.99} {
        set fe_dens_free 1
    } else {
        puts "A_Fe and Dens not required: frozen at A_Fe = 1 and the lowest table density"
        tclout param 15
        set dens_min [lindex $xspec_tclout 2]
        newpar 13 1.0 -1
        newpar 15 $dens_min -1
        fit 1000
        set fe_dens_free 0
    }
    show fit

    # Save before the error runs, so the fit is never lost
    file delete -force Ring/${obsid}_stage2.xcm
    save all Ring/${obsid}_stage2.xcm

    error 2.706 3 6 8 9 10 11 14 $c2
    if {$fe_dens_free} {
        error 2.706 13 15
    }

    # Save again: an error run that finds a better fit updates the parameters
    file delete -force Ring/${obsid}_stage2.xcm
    save all Ring/${obsid}_stage2.xcm

    # Plot
    cpd Ring/${obsid}.ps/cps
    plot eeufspec delchi
    cpd none

    # Summary line: statistic, dof, then value,lower,upper for each parameter
    tclout stat
    set row [list $obsid $xspec_tclout]
    tclout dof
    lappend row [lindex $xspec_tclout 0] $fe_dens_free
    foreach {p name} [concat $summary_params [list $c2 const_B]] {
        tclout param $p
        set value [lindex $xspec_tclout 0]
        set delta [lindex $xspec_tclout 1]
        tclout error $p
        set lo [lindex $xspec_tclout 0]
        set hi [lindex $xspec_tclout 1]
        if {$delta < 0} { set lo ""; set hi "" }   ;# frozen: no error range
        lappend row $value $lo $hi
    }
    return [join $row ","]
}

# all observations

set obsids {}
foreach f [lsort [glob -nocomplain nu*A01_sr_1000.pha]] {
    if {[regexp {^nu(.+)A01_sr_1000\.pha$} $f -> id] && [file exists nu${id}B01_sr_1000.pha]} {
        lappend obsids $id
    } else {
        puts "Skipping $f: no matching FPMB spectrum"
    }
}
puts "Observations to fit: $obsids"

proc append_line {path text} {
    set ch [open $path a]
    puts $ch $text
    close $ch
}

file delete -force Ring/summary.csv
set header [list obsid stat dof fe_dens_free]
foreach {p name} [concat $summary_params [list c2 const_B]] {
    lappend header $name ${name}_lo ${name}_hi
}
append_line Ring/summary.csv [join $header ","]

foreach id $obsids {
    puts "\n================ $id ================"
    file delete -force Ring/${id}.log
    log Ring/${id}.log
    if {[catch {fit_obs $id} result]} {
        puts "FAILED: $id: $result"
        append_line Ring/summary.csv "$id,failed"
    } else {
        append_line Ring/summary.csv $result
    }
    log none
}
puts "\nDone: results in $datadir/Ring/"

if {$batch} { exit }
